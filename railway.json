@'
{
  "build": {
    "builder": "NIXPACKS",
    "config": {
      "pythonVersion": "3.11"
    }
  },
  "deploy": {
    "startCommand": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
'@ | Out-File -FilePath railway.json -Encoding ASCII